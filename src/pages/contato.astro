---
import LayoutBase from '../layouts/LayoutBase.astro';
import { empresa } from '../data/empresa.js';
---

<LayoutBase
  titulo="Fale Conosco"
  descricao={`Entre em contato com a ${empresa.nome}.`}
>
  <section>
    <h1>Fale Conosco</h1>
    <p>Precisa de uma solução tecnológica para o seu negócio? Entre em contato com a {empresa.nome}!</p>
  </section>
  <section>
    <h2>Nossa Sede</h2>
    <address>
      {empresa.contato.endereco.logradouro}<br />
      {empresa.contato.endereco.bairro}<br />
      {empresa.contato.endereco.cidadeEstado}
    </address>
  </section>
  <section>
    <h2>Canais Digitais</h2>
    <p><strong>E-mail:</strong> <a href={`mailto:${empresa.contato.email}`}>{empresa.contato.email}</a></p>
    <p><strong>Telefone:</strong> {empresa.contato.telefone}</p>
  </section>
</LayoutBase>